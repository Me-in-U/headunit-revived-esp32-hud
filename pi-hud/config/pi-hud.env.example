# Copy this file to /etc/headunit-pi-hud.env on the Raspberry Pi.
# The runtime is intentionally standalone: OBD/CAN are read on the Pi,
# and Android bridge packets are only navigation plus backup speed.

HEADUNIT_HUD_APP_DIR=/opt/headunit-pi-hud
HEADUNIT_HUD_PI_DIR=/opt/headunit-pi-hud/pi-hud
HEADUNIT_HUD_LAYOUT=/opt/headunit-pi-hud/layouts/avante_hd_2010_default.json
HEADUNIT_HUD_VEHICLES_DIR=/opt/headunit-pi-hud/vehicles
# Require pi_hud_handoff metadata written by the Windows layout editor.
HEADUNIT_HUD_REQUIRE_HANDOFF=1

HEADUNIT_HUD_WIDTH=1920
HEADUNIT_HUD_HEIGHT=480
# HUD language: ko or en.
HEADUNIT_HUD_LANGUAGE=ko
# first-run-status.py --probe-display verifies /sys/class/graphics/fb0/virtual_size against these values.
HEADUNIT_HUD_WINDOWED=0
HEADUNIT_HUD_DUMMY=0

HEADUNIT_HUD_UDP_PORT=4210
HEADUNIT_HUD_DISCOVERY_PORT=4211
HEADUNIT_HUD_DISABLE_DISCOVERY=0

# iCar Pro 2S / ELM327 serial endpoint. Leave empty until rfcomm or USB serial is ready.
HEADUNIT_HUD_OBD_PORT=/dev/rfcomm0
HEADUNIT_HUD_OBD_BAUD=38400

# Optional Classic Bluetooth SPP auto-bind for iCar Pro 2S.
# Leave HEADUNIT_HUD_ICAR_MAC empty if the adapter is BLE-only or already appears as a serial device.
HEADUNIT_HUD_ICAR_MAC=
HEADUNIT_HUD_RFCOMM_INDEX=0
HEADUNIT_HUD_RFCOMM_CHANNEL=1

# Optional BLE ELM327/iCar path when rfcomm serial is not available.
# RX UUID is the adapter-to-Pi notify characteristic. TX UUID is the Pi-to-adapter write characteristic.
# If HEADUNIT_HUD_OBD_PORT is set, serial/rfcomm is used instead of BLE.
# Use pi-hud/scripts/scan-ble-obd.py <BLE_MAC> to list candidate RX/TX UUIDs.
HEADUNIT_HUD_OBD_BLE_MAC=
HEADUNIT_HUD_OBD_BLE_RX_UUID=
HEADUNIT_HUD_OBD_BLE_TX_UUID=

# CANable SocketCAN endpoint. Avante HD OBD CAN is the first target: DLC pin 6/14.
HEADUNIT_HUD_CAN_CHANNEL=can0
HEADUNIT_HUD_CAN_BITRATE=500000
HEADUNIT_HUD_CAN_LISTEN_ONLY=on

# Optional SDL override. Use kmsdrm on Raspberry Pi OS Lite if fullscreen needs direct KMS.
HEADUNIT_HUD_SDL_VIDEODRIVER=

# Optional git auto-update. Leave disabled until the Pi install dir is a trusted git checkout.
HEADUNIT_HUD_AUTO_UPDATE=0
HEADUNIT_HUD_GIT_REMOTE=origin
HEADUNIT_HUD_GIT_BRANCH=main
HEADUNIT_HUD_UPDATE_SERVICE=headunit-pi-hud.service
